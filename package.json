{
  "name": "cleartube-tv",
  "version": "0.5.3",
  "description": "Unofficial ad-free client for YouTube on Samsung Tizen and LG webOS TVs. Not affiliated with Google or Samsung.",
  "type": "module",
  "main": "index.js",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "webpack --mode=production",
    "build:dev": "webpack --mode=development",
    "build:tizen": "webpack --mode=production && node -e \"require('fs').copyFileSync('assets/tizen/config.xml','dist/config.xml')\"",
    "package:webos": "ares-package -n dist",
    "package:tizen": "node tools/package-wgt.js",
    "icons": "node tools/render-icons.js",
    "proxy": "node tools/proxy-server.cjs",
    "deploy:webos": "node tools/deploy.js",
    "inspect:webos": "ares-inspect youtube.leanback.v4",
    "launch:webos": "ares-launch youtube.leanback.v4",
    "manifest:webos": "node tools/gen-manifest.cjs youtube.leanback.v4.manifest.json",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:compat": "es-check",
    "lint:eslint": "eslint --concurrency auto",
    "lint:tsc": "tsc -b",
    "lint:prettier": "prettier --check .",
    "lint:all": "pnpm run \"/^lint:(?!all)/\""
  },
  "repository": "github:DavidRamirez206/ClearTube-TV",
  "license": "GPL-3.0-only",
  "bugs": "https://github.com/DavidRamirez206/ClearTube-TV/issues",
  "homepage": "https://github.com/DavidRamirez206/ClearTube-TV#readme",
  "dependencies": {
    "@babel/runtime-corejs3": "^7.29.2",
    "core-js-pure": "^3.49.0",
    "regenerator-runtime": "^0.14.1",
    "tiny-sha256": "^1.0.2",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "2.6.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/babel__core": "^7.20.5",
    "@types/babel__plugin-transform-runtime": "^7.9.5",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "3.2.4",
    "@webos-tools/cli": "github:fire332/webos-cli#6cfbcf231a0fa1e50519d370ee6e5edc71c4998a",
    "babel-loader": "^10.1.1",
    "babel-plugin-polyfill-corejs3": "^0.14.2",
    "babel-plugin-polyfill-regenerator": "^0.6.8",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "es-check": "^9.6.4",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-regexp": "^3.1.0",
    "fflate": "0.8.2",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "26.1.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.9",
    "postcss-load-config": "^6.0.1",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.2.1",
    "prettier": "^3.8.2",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.4.0",
    "transform-async-modules-webpack-plugin": "^1.1.1",
    "typescript": "^6.0.2",
    "vitest": "3.2.4",
    "webpack": "^5.106.1",
    "webpack-cli": "^7.0.2",
    "which-builtin-type": "^1.2.1"
  }
}
